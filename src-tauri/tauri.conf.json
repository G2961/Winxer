{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "winxer",
  "version": "0.1.1",
  "identifier": "com.g2961.winxer",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Winxer",
        "width": 1280,
        "height": 760,
        "minWidth": 640,
        "minHeight": 480,
        "backgroundColor": "#3a1d7a"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
